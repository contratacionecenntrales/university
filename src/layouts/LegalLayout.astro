---
import Layout from "./Layout.astro";

interface Props {
  title: string;
  description?: string;
  updated: string;
}
const { title, description, updated } = Astro.props;
---

<Layout title={title} description={description}>
  <section class="py-20 md:py-28">
    <div class="container-page">
      <div class="mx-auto max-w-3xl">
        <span class="font-mono text-xs font-semibold uppercase tracking-[0.3em] text-gold">Legal</span>
        <h1 class="mt-3 font-display text-3xl font-bold tracking-tight text-ink md:text-4xl">{title}</h1>
        <p class="mt-3 text-xs text-ink-faint">Última actualización: {updated}</p>

        <div class="legal-content mt-10">
          <slot />
        </div>
      </div>
    </div>
  </section>
</Layout>
