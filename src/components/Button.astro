---
interface Props {
  href?: string;
  variant?: "primary" | "secondary" | "ghost";
  size?: "md" | "lg";
  class?: string;
  type?: "button" | "submit";
  id?: string;
}
const { href, variant = "primary", size = "md", class: className = "", type = "button", id } = Astro.props;

const base =
  "inline-flex items-center justify-center gap-2 rounded-full font-display font-semibold tracking-tight transition-all duration-300 focus-visible:outline-2 focus-visible:outline-offset-2";

const sizes = {
  md: "px-6 py-3 text-sm",
  lg: "px-8 py-4 text-base",
};

const variants = {
  primary:
    "bg-neon text-[#05100c] shadow-[var(--shadow-glow-neon)] hover:shadow-[0_0_0_1px_rgba(0,230,168,0.8),0_0_36px_rgba(0,230,168,0.45)] hover:-translate-y-0.5",
  secondary:
    "border border-gold/60 text-gold-soft hover:bg-gold/10 hover:border-gold hover:shadow-[var(--shadow-glow-gold)]",
  ghost: "text-ink hover:text-neon",
};

const classes = `${base} ${sizes[size]} ${variants[variant]} ${className}`;
const Tag = href ? "a" : "button";
---

<Tag id={id} class={classes} href={href} type={href ? undefined : type}>
  <slot />
</Tag>
