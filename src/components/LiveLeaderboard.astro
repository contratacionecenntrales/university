---
import { LEADERBOARD_SEED } from "@/data/leaderboard";
---

<div class="card-surface rounded-3xl p-6 md:p-8">
  <div class="flex flex-wrap items-center justify-between gap-3">
    <div class="flex items-center gap-2">
      <span class="relative flex h-2.5 w-2.5">
        <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-neon opacity-75"></span>
        <span class="relative inline-flex h-2.5 w-2.5 rounded-full bg-neon"></span>
      </span>
      <span class="font-mono text-xs font-semibold uppercase tracking-[0.2em] text-neon">En vivo</span>
    </div>
    <p class="font-display text-sm font-medium text-ink-muted">Ranking de Rendimiento · Comunidad BBU</p>
  </div>

  <ol id="leaderboard-list" class="mt-6 flex flex-col gap-2">
    {
      LEADERBOARD_SEED.map((entry, index) => (
        <li
          data-id={entry.id}
          data-points={entry.points}
          class="flex items-center gap-4 rounded-xl border border-transparent bg-bg-alt/60 px-4 py-3 transition-all duration-500"
        >
          <span class="w-6 shrink-0 text-center font-mono text-sm font-semibold text-ink-faint" data-rank>
            {String(index + 1).padStart(2, "0")}
          </span>
          <span
            class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full font-display text-xs font-bold text-[#05100c]"
            style={`background:${entry.color}`}
          >
            {entry.initials}
          </span>
          <span class="min-w-0 flex-1">
            <span class="block truncate font-display text-sm font-semibold text-ink">{entry.alias}</span>
            <span class="block truncate text-xs text-ink-faint">{entry.program}</span>
          </span>
          <span class="shrink-0 text-right">
            <span class="block font-mono text-sm font-semibold text-neon" data-points-display>
              {entry.points.toLocaleString("es-ES")}
            </span>
            <span class="block text-[10px] uppercase tracking-wide text-ink-faint">pts BBU</span>
          </span>
        </li>
      ))
    }
  </ol>

  <p class="mt-6 text-[11px] leading-relaxed text-ink-faint">
    * Ranking gamificado con fines ilustrativos y de motivación interna dentro de la comunidad de alumnos. Los
    puntos reflejan un índice compuesto de actividad y progreso académico, no facturación real. No constituye
    promesa ni garantía de ingresos ni de resultados.
  </p>
</div>

<script>
  interface Row {
    id: string;
    points: number;
    el: HTMLLIElement;
  }

  const list = document.getElementById("leaderboard-list");
  if (list) {
    const rows: Row[] = Array.from(list.querySelectorAll<HTMLLIElement>("li")).map((el) => ({
      id: el.dataset.id ?? "",
      points: Number(el.dataset.points ?? 0),
      el,
    }));

    const render = () => {
      rows.sort((a, b) => b.points - a.points);
      rows.forEach((row, index) => {
        row.el.dataset.points = String(row.points);
        const rankEl = row.el.querySelector<HTMLElement>("[data-rank]");
        const pointsEl = row.el.querySelector<HTMLElement>("[data-points-display]");
        if (rankEl) rankEl.textContent = String(index + 1).padStart(2, "0");
        if (pointsEl) pointsEl.textContent = row.points.toLocaleString("es-ES");
        list.appendChild(row.el);
      });
    };

    const tick = () => {
      const target = rows[Math.floor(Math.random() * rows.length)];
      target.points += Math.floor(40 + Math.random() * 260);
      target.el.classList.add("border-neon/50", "bg-neon/5");
      window.setTimeout(() => target.el.classList.remove("border-neon/50", "bg-neon/5"), 900);
      render();
    };

    const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    if (!prefersReducedMotion) {
      window.setInterval(tick, 3200);
    }
  }
</script>
