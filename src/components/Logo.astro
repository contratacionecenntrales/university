---
interface Props {
  variant?: "full" | "icon";
  class?: string;
}
const { variant = "full", class: className = "" } = Astro.props;
---

{
  variant === "icon" ? (
    <svg viewBox="0 0 64 64" role="img" aria-label="Big Bang University" class={className}>
      <defs>
        <linearGradient id="bbu-gold-i" x1="4" y1="4" x2="60" y2="60" gradientUnits="userSpaceOnUse">
          <stop offset="0%" stop-color="#f3e3b8" />
          <stop offset="55%" stop-color="#c9a961" />
          <stop offset="100%" stop-color="#8f6f2e" />
        </linearGradient>
        <radialGradient id="bbu-navy-i" cx="50%" cy="45%" r="65%">
          <stop offset="0%" stop-color="#1b2a4a" />
          <stop offset="100%" stop-color="#0c1424" />
        </radialGradient>
        <radialGradient id="bbu-core-i" cx="50%" cy="50%" r="50%">
          <stop offset="0%" stop-color="#fff8e0" />
          <stop offset="45%" stop-color="#f2cf7d" stop-opacity="0.85" />
          <stop offset="100%" stop-color="#f2cf7d" stop-opacity="0" />
        </radialGradient>
      </defs>

      <circle cx="32" cy="32" r="28" fill="none" stroke="url(#bbu-gold-i)" stroke-width="1.1" opacity="0.85" />
      <circle cx="32" cy="32" r="22.5" fill="url(#bbu-navy-i)" stroke="url(#bbu-gold-i)" stroke-width="0.8" />

      <path
        d="M49.5 20.5 A28 28 0 0 1 53 30.5"
        fill="none"
        stroke="url(#bbu-gold-i)"
        stroke-width="1"
        stroke-dasharray="0.8 3.4"
        stroke-linecap="round"
      />

      <g fill="url(#bbu-gold-i)">
        <circle cx="32" cy="4" r="1.6" />
        <circle cx="32" cy="60" r="1.6" />
        <circle cx="53" cy="30.5" r="1.3" />
        <circle cx="11.4" cy="42" r="1.1" />
      </g>

      <circle cx="32" cy="32" r="11" fill="url(#bbu-core-i)" />
      <path
        d="M32 24.5 L34 30 L39.5 32 L34 34 L32 39.5 L30 34 L24.5 32 L30 30 Z"
        fill="url(#bbu-gold-i)"
      />
    </svg>
  ) : (
    <svg viewBox="0 0 300 64" role="img" aria-label="Big Bang University" class={className}>
      <defs>
        <linearGradient id="bbu-gold-f" x1="0" y1="0" x2="64" y2="64" gradientUnits="userSpaceOnUse">
          <stop offset="0%" stop-color="#f3e3b8" />
          <stop offset="55%" stop-color="#c9a961" />
          <stop offset="100%" stop-color="#8f6f2e" />
        </linearGradient>
        <radialGradient id="bbu-navy-f" cx="50%" cy="45%" r="65%">
          <stop offset="0%" stop-color="#1b2a4a" />
          <stop offset="100%" stop-color="#0c1424" />
        </radialGradient>
        <radialGradient id="bbu-core-f" cx="50%" cy="50%" r="50%">
          <stop offset="0%" stop-color="#fff8e0" />
          <stop offset="45%" stop-color="#f2cf7d" stop-opacity="0.85" />
          <stop offset="100%" stop-color="#f2cf7d" stop-opacity="0" />
        </radialGradient>
        <linearGradient id="bbu-silver-f" x1="0" y1="0" x2="1" y2="0">
          <stop offset="0%" stop-color="#f4f3ef" />
          <stop offset="100%" stop-color="#c7cdd8" />
        </linearGradient>
      </defs>

      <g>
        <circle cx="32" cy="32" r="28" fill="none" stroke="url(#bbu-gold-f)" stroke-width="1.1" opacity="0.85" />
        <circle cx="32" cy="32" r="22.5" fill="url(#bbu-navy-f)" stroke="url(#bbu-gold-f)" stroke-width="0.8" />
        <path
          d="M49.5 20.5 A28 28 0 0 1 53 30.5"
          fill="none"
          stroke="url(#bbu-gold-f)"
          stroke-width="1"
          stroke-dasharray="0.8 3.4"
          stroke-linecap="round"
        />
        <g fill="url(#bbu-gold-f)">
          <circle cx="32" cy="4" r="1.6" />
          <circle cx="32" cy="60" r="1.6" />
          <circle cx="53" cy="30.5" r="1.3" />
          <circle cx="11.4" cy="42" r="1.1" />
        </g>
        <circle cx="32" cy="32" r="11" fill="url(#bbu-core-f)" />
        <path d="M32 24.5 L34 30 L39.5 32 L34 34 L32 39.5 L30 34 L24.5 32 L30 30 Z" fill="url(#bbu-gold-f)" />
      </g>

      <g transform="translate(74,0)" font-family="'Sora',Arial,sans-serif">
        <text x="0" y="29" font-weight="800" font-size="21" letter-spacing="0.3" fill="url(#bbu-silver-f)">
          BIG B<tspan fill="url(#bbu-gold-f)" font-size="23">Λ</tspan>NG
        </text>
        <text x="0" y="49" font-weight="600" font-size="12.5" letter-spacing="5" fill="url(#bbu-gold-f)">
          UNIVERSITY
        </text>
      </g>
    </svg>
  )
}
