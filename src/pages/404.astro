---
import Layout from "@/layouts/Layout.astro";
import Button from "@/components/Button.astro";
---

<Layout title="Página no encontrada" noindex>
  <section class="flex min-h-[70vh] items-center py-24">
    <div class="container-page text-center">
      <span class="font-mono text-sm font-semibold uppercase tracking-[0.3em] text-gold">Error 404</span>
      <h1 class="mt-4 font-display text-4xl font-bold tracking-tight text-ink md:text-6xl">
        Esta página se ha perdido en el <span class="text-neon text-glow-neon">espacio</span>.
      </h1>
      <p class="mx-auto mt-5 max-w-lg text-base text-ink-muted">
        El contenido que buscas no existe o ha cambiado de ubicación. Vuelve al inicio o consulta nuestro catálogo
        de programas.
      </p>
      <div class="mt-9 flex flex-col items-center justify-center gap-4 sm:flex-row">
        <Button href="/" size="lg">Volver al inicio</Button>
        <Button href="/programas/" variant="secondary" size="lg">Ver programas</Button>
      </div>
    </div>
  </section>
</Layout>
