---
import Layout from "@/layouts/Layout.astro";
import LeadForm from "@/components/LeadForm.astro";
import ProgramCard from "@/components/ProgramCard.astro";
import { PROGRAMS } from "@/data/programs";

export function getStaticPaths() {
  return PROGRAMS.map((program) => ({
    params: { slug: program.slug },
    props: { program },
  }));
}

const { program } = Astro.props;
const related = PROGRAMS.filter((p) => p.slug !== program.slug).slice(0, 3);
---

<Layout title={program.title} description={program.description}>
  <section class="bg-noise py-20 md:py-28">
    <div class="container-page grid gap-12 lg:grid-cols-[1.4fr_1fr] lg:items-start">
      <div>
        <a href="/programas/" class="inline-flex items-center gap-1.5 text-sm font-medium text-ink-muted transition-colors hover:text-neon">
          ← Volver al catálogo
        </a>

        <span class="mt-6 block font-mono text-xs font-semibold uppercase tracking-[0.3em] text-gold">
          {program.category}
        </span>
        <h1 class="mt-3 font-display text-3xl font-bold tracking-tight text-ink md:text-5xl">{program.title}</h1>
        <p class="mt-5 text-base leading-relaxed text-ink-muted md:text-lg">{program.description}</p>

        <dl class="mt-8 grid grid-cols-3 gap-4 border-y border-border-soft py-6">
          <div>
            <dt class="text-xs uppercase tracking-wide text-ink-faint">Duración</dt>
            <dd class="mt-1 font-display text-sm font-semibold text-ink">{program.duration}</dd>
          </div>
          <div>
            <dt class="text-xs uppercase tracking-wide text-ink-faint">Formato</dt>
            <dd class="mt-1 font-display text-sm font-semibold text-ink">{program.format}</dd>
          </div>
          <div>
            <dt class="text-xs uppercase tracking-wide text-ink-faint">Nivel</dt>
            <dd class="mt-1 font-display text-sm font-semibold text-ink">{program.level}</dd>
          </div>
        </dl>

        <div class="mt-10">
          <h2 class="font-display text-xl font-semibold text-ink">Lo que incluye el programa</h2>
          <ul class="mt-4 grid gap-3 sm:grid-cols-2">
            {program.highlights.map((item) => (
              <li class="flex items-start gap-2.5 text-sm text-ink-muted">
                <svg viewBox="0 0 20 20" class="mt-0.5 h-4 w-4 shrink-0 text-neon" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M4 10.5l3.5 3.5L16 6" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
                {item}
              </li>
            ))}
          </ul>
        </div>

        <div class="mt-12">
          <h2 class="font-display text-xl font-semibold text-ink">Estructura del programa</h2>
          <div class="mt-4 grid gap-4">
            {program.modules.map((module, index) => (
              <div class="card-surface rounded-xl p-5">
                <div class="flex items-baseline gap-3">
                  <span class="font-mono text-xs font-semibold text-gold">{String(index + 1).padStart(2, "0")}</span>
                  <h3 class="font-display text-base font-semibold text-ink">{module.title}</h3>
                </div>
                <p class="mt-2 text-sm leading-relaxed text-ink-muted">{module.description}</p>
              </div>
            ))}
          </div>
        </div>

        <div class="mt-12">
          <h2 class="font-display text-xl font-semibold text-ink">Al terminar serás capaz de</h2>
          <ul class="mt-4 grid gap-3 sm:grid-cols-2">
            {program.outcomes.map((item) => (
              <li class="flex items-start gap-2.5 text-sm text-ink-muted">
                <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-gold"></span>
                {item}
              </li>
            ))}
          </ul>
        </div>
      </div>

      <div class="lg:sticky lg:top-24">
        <LeadForm source={program.title} program={program.slug} title="Reserva tu plaza" submitLabel="Solicitar información →" />
      </div>
    </div>
  </section>

  <section class="border-t border-border-soft py-20">
    <div class="container-page">
      <h2 class="font-display text-2xl font-bold text-ink">Otros programas</h2>
      <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {related.map((p) => <ProgramCard program={p} />)}
      </div>
    </div>
  </section>
</Layout>
